# =============================================================================
# Memeland autonomous multi-chain memecoin trading bot — environment configuration
# Copy this file to .env and configure your credentials. NEVER commit .env!
# Default scope: sol,bsc,base,eth,robinhood (the fork runs multichain; narrow with MULTICHAIN_CHAINS).
# =============================================================================

# ─── General Operating Modes ──────────────────────────────────────────────────
DRY_RUN=true                                  # true = safe simulation (default); false = LIVE ON-CHAIN TRADING
SCREENING_TIMEOUT_MS=60000                     # per-agent screening pass timeout in milliseconds (fail-closed)
AUTO_EXECUTE_ENABLED=false                     # false = signal caller only (manual links); true = automated execution
GMGN_REQUEST_SPACING_MS=300                    # min delay (ms) between GMGN API calls for rate-limit protection
VOTER_SWARM_ENABLED=true                       # Memeland fork: 10-voter swarm (quant/ml/security/sentiment/whale/regime/critic/wallet/convergence/rubric); gate floor never lowered
MULTICHAIN_CHAINS=sol,bsc,base,eth,robinhood  # comma list — provision per-chain GMGN keys first (see Fix #1)
SAFETY_GATE_ENFORCED=true                      # Q15: require an explicit safe-config (database/safe-config.json) before any fill. FAIL-CLOSED by default — flip to false only when you explicitly want an unguarded fill path.
SAFE_ROLE=agent                                # role evaluated against safe-config; only 'operator' can remediate
LIVE_TRADING_ACKNOWLEDGED=false                # live-trading acknowledgement: must be 'true' to combine DRY_RUN=false + AUTO_EXECUTE_ENABLED=true
OPERATOR_APPROVAL_REQUIRED=true                # require an explicit operator approval before any automated fill
# MarketSentinel: allow a macro risk-off regime (BTC/ETH TRENDING_BEAR/EXTREME_VOLATILITY) to trip
# the kill-switch. Default false — the regime already votes inside the swarm (regime voter); the
# bot-risk trip is ALWAYS on. Re-enable for live AUTO_EXECUTE if you want the macro veto back.
MARKET_SENTINEL_REGIME_TRIPS=false

# ─── Discord Credentials ─────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CHANNEL_CONTROL_ROOM=000000000000000000   # #opencatz-control-room channel ID

# ─── Telegram Credentials (Dual-Platform Notification Bridge) ─────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_DEPLOY_WEBHOOK_URL=                 # Optional: Discord webhook for deploy notifications

# ─── Blockchain RPC Endpoints (Robinhood Chain EVM L2, ID 4663, Native ETH) ───
EVM_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com   # canonical Robinhood Chain RPC
EVM_RPC_URL=https://rpc.mainnet.chain.robinhood.com             # fallback EVM RPC
# RPC failover pool (JSON format): {"evm": ["url1","url2"]}
RPC_FAILOVER_URLS={"evm":["https://rpc.mainnet.chain.robinhood.com"]}

# ─── AI Engine (Multi-Provider LLM with Key Failover Pool) ───────────────────
# Supported Providers: openrouter | openai | anthropic | gemini | deepseek | minimax | custom
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEYS=key_primary_123,key_backup_456  # comma-separated backup keys for automatic failover
AI_API_KEY=your_llm_api_key_here
AI_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
# Per-key provider overrides (slot 2+):
AI_KEY_2_PROVIDER=
AI_KEY_2_BASE_URL=
AI_KEY_2_MODEL_NAME=

# ─── Market Intelligence & Security APIs ─────────────────────────────────────
GMGN_API_KEY=your_gmgn_api_key_here           # GMGN OpenAPI (smart-money, ranking, trenches, security audit)
GMGN_API_KEY_ROBINHOOD=                       # Optional: dedicated GMGN key for Robinhood Chain
GMGN_API_KEY_SOL=                             # Optional per-chain keys (rotation pool, 401/403/429 failover)
GMGN_API_KEY_BSC=
GMGN_API_KEY_BASE=
GMGN_API_KEY_ETH=
X_API_BEARER_TOKEN=your_x_bearer_token_here   # Official X (Twitter) API v2 (required for Alpha Scraper agent)
GOPLUS_API_KEY=your_goplus_api_key_here       # GoPlus Security API (EVM token security audits)
UNISWAP_API_KEY=your_uniswap_api_key_here     # Uniswap Trade API (EVM swap execution & routing)

# ─── Per-Chain GMGN Key Pools (R1 + Zeabur audit Fix #1) ────────────────────
# Each pool rotates independently on 401/403/429. Filling any subset of these
# improves rate-limit resilience: with only GMGN_API_KEY + no backups, every
# audit after the first 429 silently returns null (operator-visible as
# [ROBINHOOD AGENT] ⛔ SYM: AUDIT FAIL — GMGN audit unavailable). At minimum
# fill GMGN_API_KEY_ROBINHOOD (the only chain scanned in the current default).
GMGN_API_KEY_ROBINHOOD=
GMGN_API_KEY_SOL=
GMGN_API_KEY_BSC=
GMGN_API_KEY_BASE=
GMGN_API_KEY_ETH=
# ─── Backup API Keys (Auto-Rotated on 401/403/429) ───────────────────────────
GMGN_BACKUP_KEYS=
GOPLUS_BACKUP_KEYS=
UNISWAP_BACKUP_KEYS=
X_API_BACKUP_KEYS=

# ─── Keyless Discovery Boosters (Zeabur audit Fix #3) ────────────────────────
# Keyless discovery feeds. All default to OFF. Flip the env-var to "true" to
# turn the feed on — the same prefilter + audit + voter chain applies, so
# fixes #1 (GMGN backups) + #2 (volume_1h fallback) carry over. Keyless-first:
# these feed the prefilter BEFORE GMGN (GMGN becomes enrichment only).
DEXPAPRIKA_FEED_ENABLED=         # PR7 DEXPaprika feed (discovery; pools/search API, keyless, all 5 chains)
DEXSCREENER_FEED_ENABLED=         # Q06 keyless DexScreener feed (discovery; token-profiles, no RH pairs)
GECKO_FEED_ENABLED=               # SRC-153 GeckoTerminal keyless discovery (new_pools + trending_pools, all 5 chains, 30/min budget)
RH_TAPE_ENABLED=                  # Q04 fill-tape transport (requires injected tokens)

# ─── Trading Wallet (KEEP DRY_RUN=true WHILE TESTING!) ────────────────────────
EVM_PRIVATE_KEY=your_evm_burner_private_key_here
# Per-chain EVM key overrides (R2): segregate trading keys per chain. Any
# chain in MULTICHAIN_CHAINS without a per-chain override falls back to
# EVM_PRIVATE_KEY above; if BOTH are missing, boot fails closed.
# EVM_PRIVATE_KEY_ETH=
# EVM_PRIVATE_KEY_BSC=
# EVM_PRIVATE_KEY_BASE=
# EVM_PRIVATE_KEY_ROBINHOOD=

# ─── LI.FI / Jumper — the ONLY execution layer (multi-chain) ─────────────────
LIFI_INTEGRATOR=memeland                       # your LI.FI integrator id (required for live auto-execute)
LIFI_REQUEST_SPACING_MS=300                    # min delay (ms) between LI.FI API calls (rate-limit protection)
LIFI_EXECUTION_TIMEOUT_MS=60000                # status-receipt poll window (ms) before a fill reconciles to timed_out
LIFI_SLIPPAGE_PCT=2                            # /quote slippage; accepts "2" (=2%) or "0.02" (=2%). Clamped to [0,50]%.
LIFI_NONCE_STORE_PATH=database/lifi-broadcast-nonces.json  # R3: persistent nonce store (set blank to disable)
# Per-chain funding token override (defaults in execution-registry.ts: USDC eth/bsc/base/sol, USDG robinhood)
EXECUTION_FUNDING_TOKEN_ETH=USDC
EXECUTION_FUNDING_TOKEN_BSC=USDC
EXECUTION_FUNDING_TOKEN_BASE=USDC
EXECUTION_FUNDING_TOKEN_ROBINHOOD=USDG
EXECUTION_FUNDING_TOKEN_SOL=USDC
SOLANA_PRIVATE_KEY=                            # base58 Solana secret key (required only when sol is in MULTICHAIN_CHAINS)
SOLANA_RPC_URL=                                # optional Solana RPC override (default api.mainnet-beta.solana.com)
# Optional per-chain EVM RPC overrides (defaults in lifi-executor.ts)
EVM_ETH_RPC_URL=
EVM_BSC_RPC_URL=
EVM_BASE_RPC_URL=

# ─── Execution Tuning & Strategy ──────────────────────────────────────────────
EVM_PRIORITY_FEE_GWEI=0
SIMULATION_BALANCE_ETH=1.0                    # simulated wallet balance in DRY_RUN mode
STRATEGY_PRESET=loosened                    # screening preset: loosened | standard | custom
DEFAULT_TP1_PCT=100                           # Take Profit Milestone 1 percentage (+100% / 2x)
DEFAULT_TP2_PCT=200                           # Take Profit Milestone 2 percentage (+200% / 3x)
DEFAULT_SL_PCT=-20                            # Stop Loss percentage (-20%)

# ─── REST API Server (Web Dashboard & Remote Telemetry) ───────────────────────
API_PORT=3000                                 # REST API Server port (default: 3000)
API_BIND_HOST=127.0.0.1                       # REST API bind address (default: 127.0.0.1; use 0.0.0.0 only for intentional remote exposure)
OPENCATZ_API_KEY=your_api_auth_secret_here    # API authentication key; REQUIRED for POST /api/command (fail-closed; legacy OPENCAT_API_KEY also supported)
API_ALLOWED_ORIGINS=                          # comma-separated CORS allowlist, e.g. https://dashboard.example.com (empty = no cross-origin browser access)
