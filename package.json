{
  "name": "memeland",
  "version": "1.1.0",
  "description": "Memeland — autonomous multi-agent crypto intelligence & trading ecosystem for Robinhood Chain (EVM)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "memeland": "./bin/opencatz.js",
    "opencatz": "./bin/opencatz.js",
    "opencat": "./bin/opencatz.js"
  },
  "scripts": {
    "opencatz": "node ./bin/opencatz.js",
    "opencat": "node ./bin/opencatz.js",
    "onboard": "node scripts/wizard.js",
    "wizard": "node scripts/wizard.js",
    "config": "node scripts/wizard.js",
    "dev": "tsx watch src/index.ts",
    "terminal": "tsx src/cli/tui.ts",
    "tui": "tsx src/cli/tui.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "npm ci && npm audit --omit=dev && npm run build && (npx pm2 delete memeland-agent || npx pm2 delete opencatz-agent || npx pm2 delete opencat-agent || true) && npx pm2 start dist/index.js --name memeland-agent --update-env",
    "update": "node scripts/update-core.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "clean": "node scripts/uninstall.mjs",
    "doctor": "tsx src/cli/doctor.ts",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celmaro/Memeland.git"
  },
  "bugs": {
    "url": "https://github.com/Celmaro/Memeland/issues"
  },
  "homepage": "https://github.com/Celmaro/Memeland",
  "keywords": [
    "opencatz",
    "robinhood-chain",
    "robinhood-l2",
    "evm",
    "crypto",
    "ai-agent",
    "multi-agent",
    "swarm-consensus",
    "discord-bot",
    "trading-bot",
    "uniswap-v3",
    "gmgn",
    "goplus"
  ],
  "author": "Celmaro",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7",
    "viem": "^2.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
